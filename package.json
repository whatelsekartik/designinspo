{
  "name": "infinite",
  "version": "1.0.0",
  "private": true,
  "description": "INFINITE — an AI-powered visual inspiration universe",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "agent": "tsx scripts/agent.ts",
    "agent:once": "tsx scripts/agent.ts --once",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/ingest.ts --manifest .seed/manifest.json --dir .seed/raw",
    "ingest": "tsx scripts/ingest.ts",
    "concepts": "tsx scripts/seed-concepts.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "nanoid": "^5.1.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
