# ─────────────────────────────────────────────────────────────
# INFINITE — environment configuration
# Copy to .env.local (dev) or set as secrets in your host.
# ─────────────────────────────────────────────────────────────

# ── Agent runtime ────────────────────────────────────────────
# Boot the autonomous generation loop inside the web server.
# Set to "true" for single-node deployments / preview environments.
AGENT_AUTOSTART=true
# Shared secret required by /api/agent/tick so a remote scheduler can
# drive the loop instead of the in-process runtime.
AGENT_TICK_TOKEN=

# ── Image generation provider (one of the below) ─────────────
# IMAGE_PROVIDER=openai | gemini | fal | replicate | stability
IMAGE_PROVIDER=
IMAGE_MODEL=
# openai
OPENAI_API_KEY=
# google gemini (generativelanguage)
GEMINI_API_KEY=
# fal.ai
FAL_KEY=
# replicate
REPLICATE_API_TOKEN=
# stability ai
STABILITY_API_KEY=

# ── Text model (optional) ────────────────────────────────────
# If present, the agent uses an LLM to brainstorm concepts and to write
# richer descriptions. Without it, the built-in compositional brain is used.
TEXT_PROVIDER=
TEXT_MODEL=

# ── Storage / database ───────────────────────────────────────
# Runtime database: embedded SQLite (data/infinite.db). The validated
# Postgres/Supabase schema in supabase/migrations is the hosted path.
DATA_DIR=./data

# Object storage: local (./storage/media) or supabase (public bucket).
STORAGE_DRIVER=local
NEXT_PUBLIC_MEDIA_BASE=/media
MEDIA_DIR=./storage/media

# Supabase Storage (required when STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_MEDIA_BUCKET=infinite-media
SUPABASE_SERVICE_ROLE_KEY=      # server only — never expose to the browser
